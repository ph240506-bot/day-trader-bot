# --- Alpaca (free paper account: https://app.alpaca.markets -> Paper -> API keys) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- LLM via freellmapi ---
LLM_API_KEY=            # the freellmapi-... unified key from the dashboard
LLM_MODEL=auto
LLM_MODELS=auto:fast,auto   # tried in order until one gives a readable answer
LLM_REQUIRED=true       # true = skip trades when the LLM is down
FREELLMAPI_ENCRYPTION_KEY=   # openssl rand -hex 32  (docker-compose only)

# --- What to trade ---
STOCK_SYMBOLS=SPY,QQQ,AAPL,NVDA,TSLA,AMD,MSFT,META
CRYPTO_SYMBOLS=BTC/USD,ETH/USD
TRADE_CRYPTO=false           # Alpaca's 0.5% round-trip crypto fee is bigger than the typical move

# --- Strategy ---
# orb = opening range breakout on today's "stocks in play" (the 20 stocks with the most unusual volume in the
#       first 5 minutes). The only day-trading setup with peer-reviewed, net-of-cost evidence. STOCK_SYMBOLS is
#       ignored; the bot finds its own stocks each morning.
# ema = the original EMA-cross rules on STOCK_SYMBOLS (+ top movers). Run botbacktest to compare them.
STRATEGY=orb
ORB_MINUTES=5                # opening range length (the research used 5)
ORB_TOP_N=20                 # how many stocks in play to watch
ORB_MIN_REL_VOLUME=1.0       # opening volume must be at least this many times the stock's normal opening volume
ORB_MIN_ATR_DOLLARS=0.5      # skip stocks that barely move
ORB_STOP_ATR_FRAC=0.10       # stop = this fraction of the 14-day daily ATR (research: 0.10)
ORB_STOP_MODE=atr            # atr | range (range = at least the whole opening range)
ORB_MIN_STOP_PCT=0.3         # stop never tighter than this % of price, so costs can't eat it
ORB_MAX_STOP_PCT=3.0
ORB_TARGET_R=0               # 0 = hold winners to the close (research); 3 = take profit at 3x the risk
ORB_ENTRY_WINDOW_MIN=60      # breakout must happen within an hour of the open
ORB_LLM=true                 # ask the AI about headlines before each ORB trade
ORB_POLL_SECONDS=15
ORB_ALLOW_FUNDS=false        # true = also trade ETFs / leveraged funds (SOXL, NVDX...). Off: they repeat one bet

# --- Top-mover scanner (EMA strategy only: adds today's biggest % movers to STOCK_SYMBOLS) ---
SCAN_MOVERS=true
TOP_MOVERS=10           # how many movers to add
SCAN_EVERY_MINUTES=15
MIN_PRICE=5             # skip penny stocks
MAX_PRICE=1000
MIN_MOVE_PCT=3          # only stocks up or down at least this much today
MIN_IEX_VOLUME=20000    # skip thinly traded movers

# --- Risk (percent of account) ---
RISK_PER_TRADE_PCT=1.0       # research sized each trade to lose 1% if stopped
MAX_POSITION_PCT=12          # no leverage: a tight stop + this cap means less than 1% is really at risk
MAX_OPEN_POSITIONS=8
DAILY_LOSS_LIMIT_PCT=2
STOP_ATR_MULT=1.5
REWARD_RISK=2
MIN_SIGNAL_SCORE=3
OPEN_DELAY_MIN=10            # no new stock trades in the first 10 min after the open
NO_ENTRY_BEFORE_CLOSE_MIN=30 # ...or the last 30 min (handles early-close days)
MARKET_FILTER=true           # buy only when SPY is above its VWAP, short only when below
REENTRY_COOLDOWN_MIN=30       # after a trade in a stock closes, wait this long before trading it again
MAX_CHASE_ATR=1.0            # skip if price ran more than 1 ATR between signal and order
MIN_CRYPTO_TARGET_PCT=1.5    # crypto fees are ~0.5% round trip: skip crypto trades aiming for less than this

DRY_RUN=false

# ===== Small-cap mode (separate engine, separate Alpaca PAPER account) =====
SMALLCAP_ALPACA_API_KEY=
SMALLCAP_ALPACA_SECRET_KEY=
FINNHUB_API_KEY=          # optional free key from finnhub.io, second price source
SEC_CONTACT_EMAIL=        # your email; turns on the SEC filings feed
SC_MIN_PRICE=1
SC_MAX_PRICE=20
SC_MIN_GAP_PCT=8          # must already be up this much today
SC_MIN_REL_VOLUME=1       # today's volume vs yesterday's
SC_MAX_SPREAD_PCT=3       # skip if buy/sell gap is wider than this
SC_PARK_PREMARKET=true    # no pre-market price? park the news and re-check it in the first 20 min after the open
SC_MAX_SHARES_M=50        # skip companies with more shares than this (millions); fewer = moves faster
SC_REQUIRE_SHARE_DATA=false
SC_ENTRY_MODE=pullback    # pullback = wait for the first dip and buy the bounce; immediate = buy at once
SC_WATCH_MIN=20           # how long to wait for a pullback before giving up
SC_PULLBACK_MIN_PCT=3     # a dip of at least this much off the high counts as the pullback
SC_PULLBACK_MAX_PCT=15    # deeper than this = the move failed, don't buy
SC_BOUNCE_PCT=1.5         # buy when it rises this much off the pullback low
SC_REQUIRE_ABOVE_VWAP=true
SC_STOP_BUFFER_PCT=1      # stop sits this far under the pullback low
SC_MAX_STOP_PCT=10        # skip if that stop would be further than this
SC_REWARD_RISK=2          # target = 2x the risk
SC_RISK_PER_TRADE_PCT=1   # max loss per trade if the stop is hit, % of account
SC_POSITION_USD=200       # dollars per trade
SC_MAX_POSITIONS=3
SC_MAX_TRADES_PER_DAY=6
SC_STOP_PCT=5
SC_TARGET_PCT=15
SC_TRAIL_ARM_PCT=6        # once up this much, a trailing stop follows the price
SC_TRAIL_PCT=4
SC_MAX_HOLD_MIN=30
SC_NO_ENTRY_BEFORE_CLOSE_MIN=30   # no new buys in the last 30 min of the day
SC_DAILY_LOSS_PCT=5
SC_TRADE_PREMARKET=true   # 4:00-9:30am New York = 8pm-12:30am Melbourne (Nov-Mar)
SC_LLM_MODELS=auto:fast,auto   # raced in parallel, first sensible answer wins
SC_MAX_QUOTE_AGE_SEC=180    # skip if the last trade we can see is older than this (limit orders cap the price)
SC_LLM_TIMEOUT_SEC=8
SC_SCANNER_LLM_TIMEOUT_SEC=20   # scanner hits aren't a race: give the AI longer
SC_DRY_RUN=false
SC_TRADE_NO_NEWS=false     # true = also trade no-news spikes with huge volume and few shares (riskier)
SC_NO_NEWS_MIN_REL_VOLUME=5 # ...volume at least 5x normal for the time of day
SC_NO_NEWS_MAX_SHARES_M=20  # ...under 20M shares
SC_NO_NEWS_SIZE=0.5         # ...at half the normal size
SC_SCAN_MOVERS=true       # also scan today's top gainers every minute and look up why they're moving
SC_SCAN_SEC=60
SC_SCAN_TOP=50
