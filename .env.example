# --- Alpaca (free paper account: https://app.alpaca.markets -> Paper -> API keys) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- LLM via freellmapi ---
LLM_API_KEY=            # the freellmapi-... unified key from the dashboard
LLM_MODEL=auto
LLM_REQUIRED=true       # true = skip trades when the LLM is down
FREELLMAPI_ENCRYPTION_KEY=   # openssl rand -hex 32  (docker-compose only)

# --- What to trade ---
STOCK_SYMBOLS=SPY,QQQ,AAPL,NVDA,TSLA,AMD,MSFT,META
CRYPTO_SYMBOLS=BTC/USD,ETH/USD
TRADE_CRYPTO=true

# --- Top-mover scanner (adds today's biggest % movers to STOCK_SYMBOLS) ---
SCAN_MOVERS=true
TOP_MOVERS=10           # how many movers to add
SCAN_EVERY_MINUTES=15
MIN_PRICE=5             # skip penny stocks
MAX_PRICE=1000
MIN_MOVE_PCT=3          # only stocks up or down at least this much today
MIN_IEX_VOLUME=20000    # skip thinly traded movers

# --- Risk (percent of account) ---
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=10
MAX_OPEN_POSITIONS=4
DAILY_LOSS_LIMIT_PCT=2
STOP_ATR_MULT=1.5
REWARD_RISK=2
MIN_SIGNAL_SCORE=3

DRY_RUN=false
